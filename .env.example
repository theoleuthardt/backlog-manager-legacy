# The backend URL the app calls directly, cross-origin. Baked into the build
# (it is a NEXT_PUBLIC_ variable, a name kept from the Next.js days), so it must
# be reachable from wherever the app runs; http://localhost:8000 for a local
# backend from https://github.com/theoleuthardt/backlog-manager. The GitHub
# Actions variable of the same name sets it for the release builds.
NEXT_PUBLIC_API_URL=http://localhost:8000

